{
  "name": "umafinidad-sitio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "node node_modules/vite/bin/vite.js dev",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "check": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "pretest": "node scripts/sync-assets.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "assets": "node scripts/sync-assets.mjs",
    "strings": "node scripts/extract-strings.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
